+
+def fmt(x,n=10):
+    x=mp.mpf(x);number=str(int(mp.floor(abs(x)*mp.mpf(10)**n+mp.mpf('.5')))).zfill(n+1)
+    return ('-' if x<0 else '')+number[:-n]+'.'+number[-n:]
+def sci(x,n=6):
+    x=mp.mpf(x)
+    if not x:return '0'
