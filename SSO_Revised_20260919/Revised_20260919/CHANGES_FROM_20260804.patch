+Theta=np.diag([1.,0.])
+def nuclear(A):return float(np.linalg.svd(A,compute_uv=False).sum())
+def compact(A):
+ u,s,vh=np.linalg.svd(A,full_matrices=False); keep=s>1e-12*max(1.,s[0]);return u[:,keep]@vh[keep,:]
