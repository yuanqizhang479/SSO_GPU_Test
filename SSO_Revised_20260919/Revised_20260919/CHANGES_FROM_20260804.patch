+        MR=mp.matrix(4)
+        for i in range(4):
+            for j in range(4):MR[i,j]=mp.diff(lambda d:field(t0,d)[i,j],R(0))+t1*mp.diff(lambda t:field(t,R(0))[i,j],t0)
