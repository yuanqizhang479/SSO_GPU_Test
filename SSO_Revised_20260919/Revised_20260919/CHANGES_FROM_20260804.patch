+def require(ok,msg):
+    if not ok: raise ArithmeticError(msg)
+
+def root(f,lo,hi):
+    lo,hi=mp.mpf(lo),mp.mpf(hi)
+    require(f(lo)<0<f(hi),'Root is not bracketed')
+    for _ in range(int(mp.mp.dps*3.5)+12):
+        mid=(lo+hi)/2
+        if f(mid)<0:lo=mid
+        else:hi=mid
